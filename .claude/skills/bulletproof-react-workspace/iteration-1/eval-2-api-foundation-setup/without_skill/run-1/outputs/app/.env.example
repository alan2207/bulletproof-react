# Copy this file to `.env` and fill in the values.
#
# Only variables prefixed with `VITE_` reach the browser, and every one of them
# is validated on startup by `src/config/env.ts`. A missing or malformed value
# fails immediately with a message naming the variable, rather than surfacing
# later as a confusing request error.

# Required. Base URL of the REST backend. Must be an absolute URL.
VITE_API_URL=http://localhost:3000/api

# Optional. Request timeout in milliseconds. Defaults to 15000.
# VITE_API_TIMEOUT_MS=15000
