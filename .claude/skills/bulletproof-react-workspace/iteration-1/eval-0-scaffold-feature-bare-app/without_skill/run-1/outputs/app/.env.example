# Copy to .env and adjust. Every variable here is validated at startup by
# src/config/env.ts - a missing or malformed value fails fast instead of
# turning into `undefined` at request time.
#
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
# Never put a secret in this file: everything here ships to the client.

# Base URL of the API (the tasks endpoints live at ${VITE_APP_API_URL}/tasks)
VITE_APP_API_URL=http://localhost:3000/api

# development | test | production
VITE_APP_ENV=development
