# Copy this file to `.env` and fill in the values, then restart the dev server.
# Only variables prefixed with `VITE_` are exposed to the browser.
# Every variable below is validated at startup by `src/config/env.ts`.

# REQUIRED. Base URL of the REST backend.
# Either an absolute URL (https://api.example.com) or a same-origin path (/api).
VITE_API_URL=http://localhost:3000/api

# OPTIONAL. Display name of the app. Defaults to "My App".
VITE_APP_NAME=My App
